[*.{cpp,h,hlsl,hlsli}]

charset = utf-8

spelling_error_severity = error

spelling_checkable_types = identifiers,comments

spelling_languages = en-us

spelling_use_default_exclusion_dictionary = true

spelling_exclusion_path = ./Config/exclusion.dic

[externals/**]
generated_code = true

[Archive/**]
generated_code = true

[Build/**]
generated_code = true
