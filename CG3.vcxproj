<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Development|x64">
      <Configuration>Development</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{3daa70cc-ec1d-456d-989a-86e0c5ac715f}</ProjectGuid>
    <RootNamespace>CG3</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' != 'Debug'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)' == 'Release'">true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="Exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <Import Project="Config\BuildSettings.props" />
  <PropertyGroup>
    <OutDir>$(FKEngineOutputRoot)Bin\$(Platform)\$(Configuration)\CG3\</OutDir>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <AssimpConfiguration Condition="'$(Configuration)' == 'Debug'">Debug</AssimpConfiguration>
    <AssimpConfiguration Condition="'$(Configuration)' != 'Debug'">Release</AssimpConfiguration>
    <AssimpSuffix Condition="'$(Configuration)' == 'Debug'">d</AssimpSuffix>
    <EffekseerSdkDir Condition="'$(EffekseerSdkDir)' == ''">$(FKEngineRoot)x64\EffekseerSDK</EffekseerSdkDir>
    <EffekseerLibSuffix Condition="'$(Configuration)' == 'Debug'">d</EffekseerLibSuffix>
    <EnableEffekseer Condition="'$(EnableEffekseer)' == '' and Exists('$(EffekseerSdkDir)\lib\EffekseerRendererDX12$(EffekseerLibSuffix).lib')">true</EnableEffekseer>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)' != 'Debug'">MultiThreadedDLL</RuntimeLibrary>
      <TreatWarningAsError Condition="'$(Configuration)' == 'Debug'">true</TreatWarningAsError>
      <Optimization Condition="'$(Configuration)' == 'Development'">Disabled</Optimization>
      <FunctionLevelLinking Condition="'$(Configuration)' != 'Debug'">true</FunctionLevelLinking>
      <IntrinsicFunctions Condition="'$(Configuration)' != 'Debug'">true</IntrinsicFunctions>
      <PreprocessorDefinitions>_WINDOWS;USE_IMGUI;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)externals\assimp\include;$(ProjectDir)externals\DirectXTex;$(ProjectDir)externals\imgui;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <TreatLinkerWarningAsErrors Condition="'$(Configuration)' == 'Debug'">true</TreatLinkerWarningAsErrors>
      <!-- Assimp has no bundled PDB. -->
      <AdditionalOptions Condition="'$(Configuration)' == 'Debug'">/ignore:4099 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalLibraryDirectories>$(ProjectDir)externals\assimp\lib\$(AssimpConfiguration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>assimp-vc143-md$(AssimpSuffix).lib;windowscodecs.lib;ole32.lib;d3d11.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Manifest>
      <EnableDpiAwareness>PerMonitorHighDPIAware</EnableDpiAwareness>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(EnableEffekseer)' == 'true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(EffekseerSdkDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>FK_ENABLE_EFFEKSEER;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(EffekseerSdkDir)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>Effekseer$(EffekseerLibSuffix).lib;EffekseerRendererDX12$(EffekseerLibSuffix).lib;EffekseerRendererLLGI$(EffekseerLibSuffix).lib;EffekseerRendererCommon$(EffekseerLibSuffix).lib;LLGI$(EffekseerLibSuffix).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Source\CG3\main.cpp" />
    <ClCompile Include="Source\CG3\BlackHoleEffect.cpp" />
    <ClCompile Include="Source\CG3\DebugCamera.cpp" />
    <ClCompile Include="Source\CG3\EffekseerSceneEffect.cpp" Condition="'$(EnableEffekseer)' == 'true'" />
    <ClCompile Include="Source\CG3\Matrix4x4.cpp" />
    <ClCompile Include="Source\CG3\ResourceObject.cpp" />
    <ClCompile Include="Source\CG3\Sound.cpp" />
    <ClCompile Include="Source\CG3\WinApp.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Source\CG3\BlackHoleEffect.h" />
    <ClInclude Include="Source\CG3\DebugCamera.h" />
    <ClInclude Include="Source\CG3\EffekseerSceneEffect.h" />
    <ClInclude Include="Source\CG3\Matrix4x4.h" />
    <ClInclude Include="Source\CG3\ResourceObject.h" />
    <ClInclude Include="Source\CG3\Sound.h" />
    <ClInclude Include="Source\CG3\WinApp.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Resources\Shaders\CG3\BlackHole.PS.hlsl" />
    <None Include="Resources\Shaders\CG3\BlackHole.VS.hlsl" />
    <None Include="Resources\Shaders\CG3\Object3d.hlsli" />
    <None Include="Resources\Shaders\CG3\Object3d.PS.hlsl" />
    <None Include="Resources\Shaders\CG3\Object3d.VS.hlsl" />
    <None Include="Resources\Shaders\CG3\Particle.hlsli" />
    <None Include="Resources\Shaders\CG3\Particle.PS.hlsl" />
    <None Include="Resources\Shaders\CG3\Particle.VS.hlsl" />
    <None Include="Resources\CG3\blackhole.txt" />
    <None Include="Resources\Effekseer\CosmicMist\CosmicMist.efkefc" />
    <None Include="Resources\plane.bin" />
    <None Include="Resources\plane.gltf" />
    <Text Include="externals\assimp\LICENSE.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="externals\DirectXTex\DirectXTex.vcxproj">
      <Project>{371b9fa9-4c90-4ac6-a123-aced756d6c77}</Project>
    </ProjectReference>
    <ProjectReference Include="externals\imgui\imgui.vcxproj">
      <Project>{c84755b6-9685-49fa-b1b1-86376a8674a9}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CopyRuntimeFiles" AfterTargets="Build">
    <ItemGroup>
      <CG3RuntimeResources Include="$(ProjectDir)Resources\**\*" Exclude="$(ProjectDir)Resources\**\*.blend;$(ProjectDir)Resources\CG3\blackhole.txt" />
      <RuntimeShaderDlls Include="$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxcompiler.dll;$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxil.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CG3RuntimeResources)" DestinationFiles="@(CG3RuntimeResources-&gt;'$(OutDir)Resources\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeShaderDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Resources\CG3\blackhole.txt" DestinationFiles="$(OutDir)Resources\CG3\blackhole.txt" Condition="!Exists('$(OutDir)Resources\CG3\blackhole.txt')" />
    <Copy SourceFiles="$(ProjectDir)externals\assimp\LICENSE.txt" DestinationFiles="$(OutDir)Assimp-LICENSE.txt" SkipUnchangedFiles="true" />
  </Target>
</Project>
